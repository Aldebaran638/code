{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current C++ file (in.in -> out.out)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/build/active-cpp",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build active C++ file",
            "launchCompleteCommand": "None",
            "customLaunchSetupCommands": [
                {
                    "text": "-interpreter-exec console \"run < '${workspaceFolder}/in.in' > '${workspaceFolder}/out.out'\"",
                    "description": "Run the C++ program with workspace input/output files",
                    "ignoreFailures": false
                }
            ],
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run current C++ file (in.in -> out.out)",
            "type": "node-terminal",
            "request": "launch",
            "command": "\"${workspaceFolder}/.vscode/build/active-cpp\" < \"${workspaceFolder}/in.in\" > \"${workspaceFolder}/out.out\"",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build active C++ file"
        }
    ]
}
